# Copy this file to .env.local and fill in real values.
# None of these are required for the site to build or run locally with
# placeholder content — they only matter once you wire up real services.

# Newsletter provider endpoint (Buttondown, ConvertKit, Resend, etc.)
# Used in src/lib/config.ts -> siteConfig.newsletter.action
NEWSLETTER_ENDPOINT=

# Analytics (e.g. Plausible domain, or a Vercel Analytics / PostHog key)
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Contact form backend, if you wire src/components/contact-form.tsx to a
# real API route or third-party form service.
CONTACT_FORM_ENDPOINT=
